{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "prunelle",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "prunelle": ["./packages/prunelle/src/index.ts"],
      "prunelle/server": ["./packages/prunelle/src/server/public.ts"],
      "prunelle/config": ["./packages/prunelle/src/plugins/public.ts"],
      "prunelle/test": ["./packages/prunelle/src/test/index.ts"],
      "prunelle/build": ["./packages/prunelle/src/build/index.ts"],
      "prunelle/jsx-runtime": ["./packages/prunelle/src/jsx-runtime.ts"],
      "prunelle/jsx-dev-runtime": ["./packages/prunelle/src/jsx-runtime.ts"],
      "prunelle/internal/dom": ["./packages/prunelle/src/dom/index.ts"],
      "prunelle/internal/dom-extras": ["./packages/prunelle/src/dom/extras.ts"],
      "prunelle/internal/dom-loop": ["./packages/prunelle/src/dom/loop.ts"],
      "prunelle/internal/action": ["./packages/prunelle/src/dom/action.ts"],
      "prunelle/internal/island": ["./packages/prunelle/src/dom/island.ts"],
      "prunelle/internal/ssr": ["./packages/prunelle/src/ssr/index.ts"],
      "prunelle/internal/server": ["./packages/prunelle/src/server/index.ts"],
      "@prunellejs/icons": ["./packages/plugin-icons/src/index.ts"],
      "@prunellejs/icons/plugin": ["./packages/plugin-icons/src/plugin.ts"],
      "@prunellejs/icons/search": ["./packages/plugin-icons/src/search.ts"],
      "@prunellejs/images": ["./packages/plugin-images/src/index.ts"],
      "@prunellejs/spa": ["./packages/plugin-spa/src/index.ts"],
      "@prunellejs/seo": ["./packages/plugin-seo/src/index.ts"],
      "@prunellejs/mail": ["./packages/plugin-mail/src/index.ts"],
      "@prunellejs/auth": ["./packages/plugin-auth/src/index.ts"],
      "@prunellejs/auth/sqlite": ["./packages/plugin-auth/src/sqlite.ts"],
      "@prunellejs/auth/oauth": ["./packages/plugin-auth/src/oauth.ts"],
      "@prunellejs/live": ["./packages/plugin-live/src/index.ts"],
      "@prunellejs/live/client": ["./packages/plugin-live/src/client.ts"],
      "@prunellejs/mcp": ["./packages/plugin-mcp/src/index.ts"],
      "@prunellejs/content": ["./packages/plugin-content/src/index.ts"],
      "@prunellejs/ui": ["./packages/ui/src/index.ts"],
      "@prunellejs/ui/plugin": ["./packages/ui/src/plugin.ts"],
      "@prunellejs/tailwind": ["./packages/plugin-tailwind/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src",
    "packages/*/tests",
    "bench-app",
    "examples/*/src",
    "examples/*/prunelle.config.ts",
    "packages/prunelle/templates/*/src",
    "packages/prunelle/templates/*/prunelle.config.ts"
  ]
}
