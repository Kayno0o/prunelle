{
  "name": "prunelle-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "bun check && bun run check:size && bun run check:guardrails && bun run check:dup",
    "check:size": "bun scripts/size-check.ts",
    "check:guardrails": "bun scripts/guardrails-check.ts",
    "check:dup": "bun scripts/dup-check.ts",
    "test": "bun test packages/prunelle/tests",
    "bench": "bun bench-app/bench.ts",
    "bench:server": "bun bench-app/server-bench.ts",
    "bench:weight": "bun scripts/bundle-weight.ts",
    "verify": "bun check --no-script && bun run check:size && bun run check:guardrails && bun run check:dup && bun test packages/prunelle/tests && bun bench-app/build.ts"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@kaynooo/cli-kit": "^0.52.0",
    "@types/bun": "^1.4.4",
    "axe-core": "^4.14.1",
    "happy-dom": "^21.0.4",
    "mitata": "1.0.34",
    "playwright-core": "1.64.1",
    "prunelle": "link:./packages/prunelle",
    "typescript": "^6.0.3"
  }
}
