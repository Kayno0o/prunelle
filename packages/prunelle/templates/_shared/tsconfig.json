{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "prunelle",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
